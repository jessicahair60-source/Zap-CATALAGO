# Copie este arquivo para .env e preencha.

# Endereço público da plataforma (sem barra no fim)
PUBLIC_URL=https://vitrinezap.com.br
# Domínio para subdomínios das lojas (loja.vitrinezap.com.br). Precisa de DNS curinga *. Deixe vazio para usar vitrinezap.com.br/loja
BASE_DOMAIN=
PORT=3000
NODE_ENV=production

# Nome da marca mostrado no painel e no rodapé das vitrines grátis
BRAND_NAME=Vitrine Zap
# E-mails com acesso ao painel da plataforma (/admin), separados por vírgula
ADMIN_EMAILS=jessicahair60@gmail.com

# Assinatura mensal (valor em reais) e dias de teste para contas novas (0 = sem teste)
PLAN_PRICE=47.00
TRIAL_DAYS=7

# Mercado Pago (Seu negócio > Configurações > Credenciais > Access Token de produção)
MP_ACCESS_TOKEN=
# Chave secreta dos webhooks (Suas integrações > Webhooks). URL do webhook: PUBLIC_URL/api/webhooks/mp
MP_WEBHOOK_SECRET=

# Pasta do banco de dados e das fotos. Em produção, use um disco que não é apagado a cada deploy.
DATA_DIR=
